# VEYDARA environment. Copy to .env.local (apps/web/.env.local) — never commit real values.
# All variables are SERVER-ONLY (no NEXT_PUBLIC_ prefix): keys never reach the browser.

# CoinMarketCap Pro API key (hackathon Startup plan via DoraHacks registration).
# Without it: RWA endpoints, v5 OHLCV and RWA issuer data show an honest "Unavailable" state.
CMC_API_KEY=

# Allow CMC's documented keyless public API (/public-api) for the keyless subset
# (v3 quotes, v2 info, DEX token) when no key is set. Shared IP rate pool; 429/1022 handled with backoff.
CMC_ALLOW_KEYLESS=true

# Informational: which CMC plan the key is on (basic|startup|growth|professional|enterprise).
CMC_PLAN=startup

# Optional dedicated RPCs. Defaults: https://mainnet.base.org and https://api.mainnet-beta.solana.com
# (public, rate-limited). Use a provider URL for reliability; it stays server-side.
BASE_RPC_URL=
SOLANA_RPC_URL=

# Persistence. Postgres connection string (e.g. Neon); server-only. Without it a local JSON file store is used.
# Run `pnpm db:migrate` after setting it.
DATABASE_URL=
# Optional JSON store path when DATABASE_URL is unset.
VEYDARA_DATA_FILE=
# Public origin used for SIWE domain/URI checks behind a proxy (e.g. https://veydara.example). Defaults to the request origin.
VEYDARA_PUBLIC_ORIGIN=

# Fork RPC the browser wallet adds as chain 31337 (must be loopback). Public by design: contains no secret.
NEXT_PUBLIC_FORK_RPC_URL=
