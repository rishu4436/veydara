{
  "name": "veydara",
  "private": true,
  "version": "0.1.0",
  "description": "VEYDARA \u2014 The Intelligent Crypto & RWA Capital Operating System (CMC API Hackathon Round 2, RWA track)",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @veydara/web dev",
    "build": "pnpm --filter @veydara/web build",
    "start": "pnpm --filter @veydara/web start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @veydara/web typecheck",
    "test": "vitest run",
    "test:live": "VEYDARA_LIVE_TESTS=1 vitest run tests/live",
    "check:env": "node scripts/check-env.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:registry": "node scripts/verify-registry.mjs",
    "record:cmc": "node scripts/record-cmc-keyless.mjs",
    "probe:cmc": "node scripts/probe-cmc-plan.mjs --save",
    "record:aave": "VEYDARA_LIVE_TESTS=1 VEYDARA_RECORD=1 vitest run tests/live/aave-v4-record.test.ts",
    "fork": "node scripts/fork.mjs",
    "record:fork": "VEYDARA_FORK_TESTS=1 vitest run tests/fork",
    "e2e": "playwright test",
    "e2e:fork": "E2E_FORK=1 playwright test",
    "db:generate": "pnpm --filter @veydara/store db:generate",
    "db:migrate": "pnpm --filter @veydara/store db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@veydara/chains": "workspace:*",
    "@veydara/cmc": "workspace:*",
    "@veydara/domain": "workspace:*",
    "@veydara/execution": "workspace:*",
    "@veydara/protocols": "workspace:*",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "viem": "^2.58.4",
    "vitest": "^3.2.4",
    "@veydara/store": "workspace:*",
    "@veydara/intent": "workspace:*",
    "@veydara/auth": "workspace:*",
    "@veydara/kamino": "workspace:*"
  }
}
